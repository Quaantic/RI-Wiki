{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node server/vercel-ignore.cjs",
  "functions": {
    "api/icons.js": {
      "includeFiles": "images/icons/custom/**"
    }
  },
  "buildCommand": "node server/generate-icon-index.cjs",
  "rewrites": [
    {
      "source": "/_ri-arcane-vault/:code",
      "destination": "/api/editor-entry?code=:code"
    }
  ]
}
