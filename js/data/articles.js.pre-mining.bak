            { perk: 'Song of Roots', trigger: '30 casts at Hollows Spring, then talk to the tree', effect: 'Torch time +10%' },
            { perk: 'Cartographer\'s Debt', trigger: 'Die in all three dungeons once each', effect: 'Dungeon maps permanently revealed' },
          ]
        ),
      ]),
      section('Verification', [
        p('All four triggers are verified on v1.2.0. Song of Roots is the fiddliest — the 30 casts must be before the conversation with the tree, in any order of days. Cartographer\'s Debt is the only one with no in-game hint at all; the community found it by diffing achievement flags.'),
      ]),
    ],
    related: ['hidden-gates', 'perk-points', 'skill-fishing'],
  }),
];


const ARTICLES = [
  ...mainArticles, ...lifeArticles, ...treeArticles, ...miningArticles,
  ...dungeonArticles, ...perkArticles,
];

const ARTICLE_INDEX = new Map(ARTICLES.map((a) => [a.id, a]));

export { ARTICLES, ARTICLE_INDEX };
