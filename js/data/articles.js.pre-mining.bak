// ==== ARTIGOS - EDITE AQUI ====
// article({ id, category, subcategory, title, description, stats, sections, related })
// Blocos: p() list() table() note() kv() section(titulo, blocos, {collapsed:true})


const p = (text) => ({ type: 'p', text });

const list = (items, { ordered = false, checks = false } = {}) => ({
  type: 'list',
  items: items.map((it) => (typeof it === 'string' ? { text: it } : it)),
  ordered,
  checks,
});

const table = (columns, rows) => ({ type: 'table', columns, rows });

const note = (variant, title, text) => ({ type: 'note', variant, title, text });

const kv = (pairs) => ({ type: 'kv', pairs });

const section = (title, blocks, { collapsed = false } = {}) => ({ title, blocks, collapsed });

function article(a) {
  return {
    keywords: [],
    stats: [],
    sections: [],
    related: [],
    updated: '2026-10-20',
    views: 0,
    featured: false,
    ...a,
  };
}

const stat = (label, value, icon = 'info') => ({ label, value, icon });

const resourceStats = (value, tier, smelts) => [
  stat('Base value', value, 'coin'),
  stat('Tier', tier, 'layers'),
  stat('Smelts into', smelts, 'flask'),
];

const gearStats = (power, speed, perk) => [
  stat('Power', power, 'hammer'),
  stat('Speed', speed, 'gauge'),
  stat('Signature perk', perk, 'star'),
];

const creatureStats = (hp, damage, drops) => [
  stat('Health', hp, 'heart'),
  stat('Damage', damage, 'sword'),
  stat('Notable drop', drops, 'package'),
];

const locationStats = (region, unlock, ores) => [
  stat('Region', region, 'map-pin'),
  stat('Unlocked by', unlock, 'key'),
  stat('Ore pool', ores, 'gem'),
];


